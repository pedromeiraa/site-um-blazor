@page "/contador"
@rendermode InteractiveServer

<h1>Contador</h1>

<p role="status">Contador: @currentCount</p>

<button class="btn btn-primary" @onclick="contabilizar">Clique Aqui</button>

@code {
    private int currentCount = 0;

    private void contabilizar()
    {
        currentCount++;
    }
}